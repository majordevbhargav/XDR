# Copy to .env locally if you use a dotenv loader, or export these variables in your shell.
# Never put real credentials in this file or commit a populated .env.
XDR_ID=
XDR_PW=
XDR_TOKEN_URL=
XDR_REGION=apjc

# Workflow execution is disabled unless explicitly enabled after checking the tenant OpenAPI schema.
XDR_ALLOW_WORKFLOW_START=false
